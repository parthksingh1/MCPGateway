# ---------------------------------------------------------------------------
# mcpgateway — copy to .env and adjust. Every value below is validated by the
# Zod schema in packages/shared/src/config.ts; the process refuses to boot on
# an invalid value rather than starting in a half-configured state.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# --- Datastores ------------------------------------------------------------
DATABASE_URL=postgres://mcpgw:mcpgw@localhost:5432/mcpgateway
WAREHOUSE_DATABASE_URL=postgres://mcpgw:mcpgw@localhost:5432/warehouse
# Least-privilege role used only by the audit writer (INSERT-only on audit_events).
AUDIT_DATABASE_URL=postgres://mcpgw_audit:mcpgw_audit@localhost:5432/mcpgateway
REDIS_URL=redis://localhost:6379

# --- Identity provider (OAuth 2.1 / RFC 8693) ------------------------------
# Point OIDC_ISSUER at any RFC 8693-capable provider to swap the bundled one out.
OIDC_ISSUER=http://localhost:9000
OIDC_ISSUER_INTERNAL=http://localhost:9000
GATEWAY_CLIENT_ID=mcp-gateway
GATEWAY_CLIENT_SECRET=gateway-secret-change-me
DASHBOARD_CLIENT_ID=dashboard-bff
DASHBOARD_CLIENT_SECRET=dashboard-secret-change-me
SESSION_COOKIE_SECRET=change-me-to-a-32-byte-random-string-value

# --- Gateway ---------------------------------------------------------------
GATEWAY_PORT=8080
GATEWAY_HOST=0.0.0.0
GATEWAY_PUBLIC_URL=http://localhost:8080
DASHBOARD_ORIGIN=http://localhost:3000
TOKEN_EXCHANGE_CACHE_MAX_TTL_SECONDS=300

# --- Upstream MCP servers --------------------------------------------------
MCP_SALESFORCE_URL=http://localhost:7001/mcp
MCP_POSTGRES_URL=http://localhost:7002/mcp
MCP_POLICY_URL=http://localhost:7003/mcp

# --- MCP server processes --------------------------------------------------
SALESFORCE_PORT=7001
POSTGRES_MCP_PORT=7002
POLICY_PORT=7003
IDP_PORT=9000

# --- Telemetry -------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_SDK_DISABLED=false
JAEGER_UI_URL=http://localhost:16686
GRAFANA_URL=http://localhost:3001

# --- Feature flags ---------------------------------------------------------
# Persist canonicalised tool arguments alongside the hash. Off by default:
# arguments frequently carry PII and the chain only needs the digest.
AUDIT_PAYLOAD_CAPTURE=false
