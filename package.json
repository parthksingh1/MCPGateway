{
  "name": "mcpgateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Enterprise gateway and server suite for the Model Context Protocol",
  "license": "MIT",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --project unit --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "reset": "tsx scripts/reset-demo.ts",
    "verify:audit": "tsx scripts/verify-audit-chain.ts",
    "oauth:walkthrough": "tsx scripts/demo-oauth-flow.ts",
    "bench": "tsx scripts/load-test.ts",
    "load-test:local": "tsx scripts/load-test.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@mcpgateway/audit": "workspace:^",
    "@mcpgateway/auth": "workspace:^",
    "@mcpgateway/mcp-runtime": "workspace:^",
    "@mcpgateway/rate-limit": "workspace:^",
    "@mcpgateway/shared": "workspace:^",
    "@mcpgateway/telemetry": "workspace:^",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@playwright/test": "^1.49.1",
    "@testcontainers/postgresql": "^12.1.0",
    "@testcontainers/redis": "^12.1.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitest/coverage-v8": "^2.1.8",
    "drizzle-kit": "^0.30.1",
    "drizzle-orm": "^0.38.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "fastify": "^4.29.0",
    "husky": "^9.1.7",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "lint-staged": "^15.3.0",
    "pg": "^8.13.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0 --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
